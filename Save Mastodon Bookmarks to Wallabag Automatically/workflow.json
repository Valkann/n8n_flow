      "notesInFlow": true,
      "notes": "Reads the last processed bookmark ID (min_id) from the Data Table `mastodon_sync_state`."
    },
    {
      "parameters": {
        "jsCode": "// Table mastodon_sync_state : une seule ligne attendue.\n// Si la table est vide (premier run), on repart de la valeur par defaut.\nconst DEFAULT_MIN_ID = 0; // 0 = start from your oldest bookmarks\nconst items = $input.all();\n\nlet minId = DEFAULT_MIN_ID;\nif (items.length > 0 && items[0].json && items[0].json.min_id !== undefined && items[0].json.min_id !== null && items[0].json.min_id !== '') {\n  minId = items[0].json.min_id;\n}\n\nreturn [\n  { json: { min_id: minId } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
