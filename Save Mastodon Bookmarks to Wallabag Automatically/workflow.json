    {
      "parameters": {
        "jsCode": "// Extrait les parametres de pagination (min_id, max_id, ...) du header Link\n// et les ajoute directement sur l'item courant.\nconst links = $input.first().json.headers.link;\nlet regexp = /(?:\\?|\\&)(?<key>[\\w]+)=(?<value>[\\w+,.-]+)/g;\nlet results = links.matchAll(regexp);\nfor (let match of results) {\n  let key = match.groups.key;\n  let value = match.groups.value;\n  $input.last().json[key] = value;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        480
      ],
      "id": "25495227-4900-478e-a32d-177f230bd8b4",
      "name": "Parse pagination header",
